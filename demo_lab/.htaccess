RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Clean URLs: Map /page to /page.html if page.html exists
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^\.]+)$ .html [NC,L]

# Explicit routes
RewriteRule ^admin/?$ admin.html [NC,L]
RewriteRule ^influencer/?$ influencer.html [NC,L]
RewriteRule ^product/?$ product.html [NC,L]
RewriteRule ^track/?$ track-order.html [NC,L]
RewriteRule ^track-order/?$ track-order.html [NC,L]
RewriteRule ^reviews/?$ reviews.html [NC,L]
RewriteRule ^ingredients/?$ ingredients.html [NC,L]
RewriteRule ^how-to-use/?$ how-to-use.html [NC,L]
RewriteRule ^ai-consultant/?$ ai-consultant.html [NC,L]
RewriteRule ^contact/?$ contact.html [NC,L]
