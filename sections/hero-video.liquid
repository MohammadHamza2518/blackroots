<section id="hero" class="relative min-h-[80vh] flex items-center justify-center overflow-hidden bg-[#090a0d] py-12 sm:py-16 select-none border-b border-[#d4af37]/20">
  
  <!-- Soft Ambient Gold Glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-3xl h-80 rounded-full pointer-events-none" style="background: radial-gradient(circle, rgba(212,175,55,0.08) 0%, transparent 70%);"></div>

  <div class="relative z-20 max-w-5xl mx-auto px-4 text-center space-y-6">
    
    <!-- Top Tagline Pill -->
    <div class="inline-flex items-center justify-center gap-1.5 px-3.5 py-1.5 rounded-full bg-[#d4af37]/10 border border-[#d4af37]/50 text-[#d4af37] text-[10px] sm:text-xs font-extrabold uppercase tracking-wide backdrop-blur-xl shadow-[0_10px_25px_rgba(212,175,55,0.15)] mx-auto text-center max-w-full">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse shrink-0"></span>
      <span class="whitespace-nowrap">👫 100% UNISEX &bull; JAPANESE BOTANICAL FORMULA</span>
    </div>

    <!-- Main Headline -->
    <h1 class="font-serif text-3xl sm:text-5xl md:text-6xl font-bold text-white tracking-tight leading-[1.15] max-w-4xl mx-auto">
      Say Goodbye to Grey Hair <br class="hidden sm:block">
      <span class="gold-gradient-text italic font-normal">Naturally &amp; Permanently.</span>
    </h1>

    <p class="text-sm sm:text-base md:text-lg text-gray-300 max-w-2xl mx-auto font-light leading-relaxed">
      Japanese-inspired herbal shampoo with active botanical indigo &amp; amla. Turns grey hair naturally black, halts hair fall, and ends dandruff in just 3-minute shower washes.
    </p>

    <!-- CTAs & Pricing Strip -->
    <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3.5 max-w-md mx-auto">
      <a href="/products/blackroots-herbal-hair-dye-shampoo" class="btn-gold-luxury btn-shimmer w-full sm:w-auto text-sm sm:text-base py-4 px-8 rounded-2xl shadow-[0_10px_30px_rgba(212,175,55,0.4)] flex items-center justify-center gap-2 font-black uppercase tracking-wider text-black transition-all hover:scale-105 active:scale-95">
        <span>Order Now &mdash; ₹499</span>
        <span>&rarr;</span>
      </a>
      <a href="/pages/how-to-use" class="w-full sm:w-auto px-6 py-3.5 rounded-2xl bg-white/5 border border-white/10 hover:border-[#d4af37]/50 text-gray-300 hover:text-white text-xs font-bold uppercase tracking-wider transition-all">
        🚿 Shower Ritual
      </a>
    </div>

    <!-- Trust Badges -->
    <div class="pt-6 flex flex-wrap items-center justify-center gap-4 sm:gap-6 text-xs text-gray-300 font-medium">
      <div class="flex items-center gap-1.5 text-emerald-400"><span>🚚</span> <span>Free Express Delivery Across India</span></div>
      <div class="flex items-center gap-1.5 text-amber-300"><span>🛡️</span> <span>100% Herbal Guaranteed</span></div>
      <div class="flex items-center gap-1.5 text-gray-300"><span>💵</span> <span>Cash On Delivery Available</span></div>
    </div>

  </div>

</section>

