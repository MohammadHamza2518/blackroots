<section id="how-to-use" class="py-16 md:py-24 bg-[#0a0b0e] relative border-b border-[#d4af37]/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-[#d4af37]/10 border border-[#d4af37]/40 text-[#d4af37] text-[10px] sm:text-xs font-extrabold uppercase tracking-widest mb-3">
        3-Minute Easy Shower Ritual
      </span>
      <h2 class="font-serif text-3xl sm:text-5xl font-bold text-white mb-4">
        How to Use <span class="gold-gradient-text">BlackRoots</span>
      </h2>
      <p class="text-gray-300 text-sm sm:text-base font-light">
        No bowl mixing, no messy gloves, zero chemicals. Use just like your regular daily shampoo during shower time.
      </p>
    </div>

    <!-- Stepper Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6 mb-12">
      
      <div class="p-6 rounded-3xl bg-[#12151c] border border-[#d4af37]/30 hover:border-[#d4af37] shadow-xl text-center flex flex-col items-center group transition-all">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-r from-[#d4af37] to-[#aa7c11] text-black font-black text-lg flex items-center justify-center mb-4 shadow-lg group-hover:scale-110 transition-transform">1</div>
        <h4 class="font-serif text-lg font-bold text-white mb-2">Wet Hair</h4>
        <p class="text-xs text-gray-400 font-light leading-relaxed">Wet your hair and scalp thoroughly with normal shower water.</p>
      </div>

      <div class="p-6 rounded-3xl bg-[#12151c] border border-[#d4af37]/30 hover:border-[#d4af37] shadow-xl text-center flex flex-col items-center group transition-all">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-r from-[#d4af37] to-[#aa7c11] text-black font-black text-lg flex items-center justify-center mb-4 shadow-lg group-hover:scale-110 transition-transform">2</div>
        <h4 class="font-serif text-lg font-bold text-white mb-2">Apply Shampoo</h4>
        <p class="text-xs text-gray-400 font-light leading-relaxed">Pump a generous amount and work into a rich natural herbal lather.</p>
      </div>

      <div class="p-6 rounded-3xl bg-[#12151c] border border-[#d4af37]/30 hover:border-[#d4af37] shadow-xl text-center flex flex-col items-center group transition-all">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-r from-[#d4af37] to-[#aa7c11] text-black font-black text-lg flex items-center justify-center mb-4 shadow-lg group-hover:scale-110 transition-transform">3</div>
        <h4 class="font-serif text-lg font-bold text-white mb-2">3-Min Scalp Massage</h4>
        <p class="text-xs text-gray-400 font-light leading-relaxed">Gently massage scalp roots for 3 minutes for bio-pigment absorption.</p>
      </div>

      <div class="p-6 rounded-3xl bg-[#12151c] border border-[#d4af37]/30 hover:border-[#d4af37] shadow-xl text-center flex flex-col items-center group transition-all">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-r from-[#d4af37] to-[#aa7c11] text-black font-black text-lg flex items-center justify-center mb-4 shadow-lg group-hover:scale-110 transition-transform">4</div>
        <h4 class="font-serif text-lg font-bold text-white mb-2">Rinse Clean</h4>
        <p class="text-xs text-gray-400 font-light leading-relaxed">Rinse thoroughly until water runs clear. No residue on skin or towels.</p>
      </div>

      <div class="p-6 rounded-3xl bg-[#12151c] border border-[#d4af37]/30 hover:border-[#d4af37] shadow-xl text-center flex flex-col items-center group transition-all">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-r from-[#d4af37] to-[#aa7c11] text-black font-black text-lg flex items-center justify-center mb-4 shadow-lg group-hover:scale-110 transition-transform">5</div>
        <h4 class="font-serif text-lg font-bold text-white mb-2">Use 2-3x Weekly</h4>
        <p class="text-xs text-gray-400 font-light leading-relaxed">Maintain naturally rich black hair luster and dandruff-free scalp health.</p>
      </div>

    </div>

    <!-- CTA & Full Ritual Guide Link -->
    <div class="text-center">
      <a href="/pages/how-to-use" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white/5 border border-white/10 hover:border-[#d4af37]/50 text-amber-300 text-xs font-bold uppercase tracking-wider transition-all">
        <span>Open Interactive 3-Minute Shower Massage Timer</span>
        <span>&rarr;</span>
      </a>
    </div>

  </div>
</section>

