<section class="py-20 bg-gradient-to-b from-black via-zinc-950 to-black border-t border-b border-white/5">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      
      <!-- Video / Image Preview Card -->
      <div class="relative rounded-2xl overflow-hidden gold-border-glow bg-zinc-900 group">
        <video autoplay muted loop playsinline class="w-full h-[400px] sm:h-[480px] object-cover">
          <source src="{{ section.settings.feature_video | default: 'blackroots-hero-video-man.mp4' }}" type="video/mp4">
        </video>
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>
        <div class="absolute bottom-6 left-6 right-6 p-4 rounded-xl glass-panel">
          <div class="flex items-center justify-between text-xs text-amber-400 font-semibold uppercase tracking-wider mb-1">
            <span>Real Results Over Regular Use</span>
            <span>Suitable for Men & Women</span>
          </div>
          <p class="text-sm text-gray-200 m-0">
            Witness gradual cover of greys with rich, natural-looking dark shine after just a few weeks of consistent ritual.
          </p>
        </div>
      </div>

      <!-- Feature Content -->
      <div class="flex flex-col justify-center">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-950/80 border border-emerald-500/30 text-emerald-400 text-xs font-semibold uppercase tracking-widest mb-4 w-max">
          {% render 'icon-leaf' %}
          <span>100% Herbal & Botanical Formulation</span>
        </div>

        <h2 class="font-serif text-3xl sm:text-5xl font-bold text-white mb-6 leading-tight">
          Natural Hair Color <br>
          <span class="gold-gradient-text">Without Harsh Chemicals</span>
        </h2>

        <p class="text-gray-300 text-base sm:text-lg leading-relaxed mb-6 font-light">
          Unlike synthetic dyes loaded with ammonia and peroxide that damage hair roots, BlackRoots works harmoniously with your scalp's biology using centuries-old Japanese indigo and ayurvedic botanical extracts.
        </p>

        <ul class="space-y-4 mb-8">
          <li class="flex items-start gap-3">
            <div class="p-1 rounded-full bg-amber-500/20 text-amber-400 mt-1">
              {% render 'icon-check' %}
            </div>
            <div>
              <strong class="text-white font-medium block">No Ammonia, No Peroxide, No Paraben</strong>
              <span class="text-sm text-gray-400">Gentle on scalp, non-staining skin formulation.</span>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <div class="p-1 rounded-full bg-amber-500/20 text-amber-400 mt-1">
              {% render 'icon-check' %}
            </div>
            <div>
              <strong class="text-white font-medium block">Multi-Action Scalp Therapy</strong>
              <span class="text-sm text-gray-400">Combats dandruff while strengthening hair follicles from root to tip.</span>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <div class="p-1 rounded-full bg-amber-500/20 text-amber-400 mt-1">
              {% render 'icon-check' %}
            </div>
            <div>
              <strong class="text-white font-medium block">Effortless 5-Minute Shower Ritual</strong>
              <span class="text-sm text-gray-400">Replaces your regular shampoo without tedious mixing or bowl preparation.</span>
            </div>
          </li>
        </ul>

        <div>
          <a href="#product-main" class="btn-primary">
            Claim Your 250ml Bottle — ₹499
          </a>
        </div>

      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Feature",
  "settings": [
    {
      "type": "text",
      "id": "feature_video",
      "label": "Feature Video URL",
      "default": "blackroots-hero-video-man.mp4"
    }
  ]
}
{% endschema %}
