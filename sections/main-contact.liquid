<section class="py-12 sm:py-16 md:py-24 bg-[#0a0b0e] text-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-14 space-y-3">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-[#d4af37]/10 border border-[#d4af37]/40 text-[#d4af37] text-[10px] sm:text-xs font-extrabold uppercase tracking-widest">
        We Are Here For You 24/7
      </span>
      <h1 class="font-serif text-3xl sm:text-5xl font-bold text-white tracking-tight">
        Contact <span class="gold-gradient-text">BlackRoots</span>
      </h1>
      <p class="text-gray-300 text-xs sm:text-sm max-w-xl mx-auto font-light leading-relaxed">
        Have questions about our Japanese Herbal Hair Dye Shampoo or your order shipment? We are here to assist!
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Contact Info Cards (5 cols) -->
      <div class="lg:col-span-5 space-y-4">
        
        <div class="p-6 rounded-3xl bg-[#12151c] border border-[#d4af37]/30 shadow-xl space-y-2">
          <div class="flex items-center gap-3">
            <span class="text-2xl">📧</span>
            <h4 class="font-serif text-lg font-bold text-white m-0">Email Support</h4>
          </div>
          <p class="text-xs text-gray-400 font-light leading-relaxed m-0">Send us your inquiries anytime. Guaranteed reply within 24 hours.</p>
          <a href="mailto:blackroots.in@gmail.com" class="text-amber-300 font-bold text-xs sm:text-sm hover:underline block pt-1 break-all">blackroots.in@gmail.com</a>
        </div>

        <div class="p-6 rounded-3xl bg-[#12151c] border border-emerald-500/40 shadow-xl space-y-2">
          <div class="flex items-center gap-3">
            <span class="text-2xl">💬</span>
            <h4 class="font-serif text-lg font-bold text-white m-0">Direct WhatsApp Helpdesk</h4>
          </div>
          <p class="text-xs text-gray-400 font-light leading-relaxed m-0">Instant assistance for order tracking, courier inquiries, and usage advice.</p>
          <a href="https://wa.me/919580835179?text=Hello%20BlackRoots%20Team%2C%20I%20have%20a%20question" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-emerald-400 font-extrabold text-xs sm:text-sm hover:underline pt-1">
            <span>+91 9580835179 (WhatsApp)</span>
            <span>&rarr;</span>
          </a>
        </div>

        <div class="p-6 rounded-3xl bg-[#12151c] border border-white/10 shadow-xl space-y-2">
          <h4 class="font-serif text-lg font-bold text-white m-0">Manufacturing &amp; Headquarters</h4>
          <p class="text-xs text-gray-400 font-light leading-relaxed m-0">
            <strong class="text-white">Manufactured at:</strong> Shuklaganj, Uttar Pradesh – 209861, Near Poni Road, India
          </p>
          <p class="text-xs text-gray-400 font-light leading-relaxed m-0">
            <strong class="text-white">Marketed by:</strong> HRS Group
          </p>
        </div>

      </div>

      <!-- Contact Form (7 cols) -->
      <div class="lg:col-span-7 p-6 sm:p-8 rounded-3xl bg-[#12151c] border border-[#d4af37]/40 shadow-2xl">
        <h3 class="font-serif text-2xl font-bold text-white mb-6">Send Us a Direct Message</h3>
        
        <form onsubmit="event.preventDefault(); alert('Thank you! Your message has been received. Our team will contact you shortly.');" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-amber-300 mb-1.5">Your Full Name <span class="text-amber-400">*</span></label>
              <input type="text" placeholder="e.g. Alok Mishra" required class="w-full px-4 py-3 rounded-xl bg-black border border-white/20 text-white text-xs sm:text-sm focus:outline-none focus:border-[#d4af37] transition-all">
            </div>
            <div>
              <label class="block text-xs font-bold uppercase tracking-wider text-amber-300 mb-1.5">Mobile Number <span class="text-amber-400">*</span></label>
              <input type="tel" placeholder="e.g. 9876543210" required class="w-full px-4 py-3 rounded-xl bg-black border border-white/20 text-white text-xs sm:text-sm focus:outline-none focus:border-[#d4af37] transition-all">
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-amber-300 mb-1.5">Email Address</label>
            <input type="email" placeholder="e.g. yourname@example.com" class="w-full px-4 py-3 rounded-xl bg-black border border-white/20 text-white text-xs sm:text-sm focus:outline-none focus:border-[#d4af37] transition-all">
          </div>

          <div>
            <label class="block text-xs font-bold uppercase tracking-wider text-amber-300 mb-1.5">Message / Inquiry / Order ID <span class="text-amber-400">*</span></label>
            <textarea rows="4" placeholder="How can our hair care team help you today?" required class="w-full px-4 py-3 rounded-xl bg-black border border-white/20 text-white text-xs sm:text-sm focus:outline-none focus:border-[#d4af37] transition-all"></textarea>
          </div>

          <button type="submit" class="w-full bg-gradient-to-r from-[#d4af37] via-[#f7e7a7] to-[#aa7c11] text-black font-black text-xs sm:text-sm py-4 rounded-xl shadow-xl hover:brightness-110 active:scale-95 transition-all uppercase tracking-wider cursor-pointer">
            Send Message &rarr;
          </button>
        </form>
      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Contact Page",
  "settings": []
}
{% endschema %}
