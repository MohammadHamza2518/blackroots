<section id="reviews" class="py-16 md:py-24 bg-[#0a0b0e] relative border-b border-[#d4af37]/20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
      <a href="/pages/reviews" class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#d4af37]/10 border border-[#d4af37]/40 text-[#d4af37] text-xs font-extrabold uppercase tracking-widest hover:scale-105 transition-transform">
        <span class="text-amber-400">★★★★★</span>
        <span>4.9 / 5.0 &bull; 1,280+ Verified Reviews</span>
      </a>
      <h2 class="font-serif text-3xl sm:text-5xl font-bold text-white tracking-tight">
        Loved By <span class="gold-gradient-text">1,280+ Indian Customers</span>
      </h2>
      <p class="text-gray-300 text-sm sm:text-base font-light">
        Real experiences and verified hair transformations from men &amp; women across India.
      </p>
    </div>

    <!-- Review Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      
      <!-- Review 1 -->
      <div class="p-6 sm:p-8 rounded-3xl bg-[#12151c] border border-[#d4af37]/30 hover:border-[#d4af37] shadow-xl flex flex-col justify-between transition-all group">
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center text-amber-400 text-sm tracking-wider">★★★★★</div>
            <span class="text-[10px] text-emerald-400 bg-emerald-950/80 px-2.5 py-0.5 rounded-full border border-emerald-500/30 font-bold">✨ Verified Purchase</span>
          </div>
          <h4 class="font-serif text-lg font-bold text-white mb-2 leading-snug">"Finally no chemical dye burning!"</h4>
          <p class="text-xs sm:text-sm text-gray-300 leading-relaxed mb-4 font-light">
            Regular hair dyes always caused severe scalp itching for me. BlackRoots works gradually during regular shower washes and covered my temple greys naturally within 2 weeks.
          </p>
        </div>
        <div class="pt-4 border-t border-white/10 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-gradient-to-r from-[#d4af37] to-[#aa7c11] text-black font-black text-xs flex items-center justify-center">RK</div>
            <div>
              <span class="text-xs sm:text-sm font-bold text-white block">Rajesh Kumar</span>
              <span class="text-[10px] text-gray-400">New Delhi &bull; 42 yrs</span>
            </div>
          </div>
          <span class="text-[11px] text-amber-400 font-mono">1 Bottle Pack</span>
        </div>
      </div>

      <!-- Review 2 -->
      <div class="p-6 sm:p-8 rounded-3xl bg-[#12151c] border border-[#d4af37]/30 hover:border-[#d4af37] shadow-xl flex flex-col justify-between transition-all group">
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center text-amber-400 text-sm tracking-wider">★★★★★</div>
            <span class="text-[10px] text-emerald-400 bg-emerald-950/80 px-2.5 py-0.5 rounded-full border border-emerald-500/30 font-bold">✨ Verified Purchase</span>
          </div>
          <h4 class="font-serif text-lg font-bold text-white mb-2 leading-snug">"Stopped my hair fall &amp; grey roots"</h4>
          <p class="text-xs sm:text-sm text-gray-300 leading-relaxed mb-4 font-light">
            The best part is my hair fall stopped almost completely by week 2. Hair feels silky soft, shiny and naturally black without looking like an artificial fake wig.
          </p>
        </div>
        <div class="pt-4 border-t border-white/10 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-gradient-to-r from-[#d4af37] to-[#aa7c11] text-black font-black text-xs flex items-center justify-center">SP</div>
            <div>
              <span class="text-xs sm:text-sm font-bold text-white block">Sunita Patel</span>
              <span class="text-[10px] text-gray-400">Mumbai &bull; 38 yrs</span>
            </div>
          </div>
          <span class="text-[11px] text-amber-400 font-mono">2 Bottles Pack</span>
        </div>
      </div>

      <!-- Review 3 -->
      <div class="p-6 sm:p-8 rounded-3xl bg-[#12151c] border border-[#d4af37]/30 hover:border-[#d4af37] shadow-xl flex flex-col justify-between transition-all group">
        <div>
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center text-amber-400 text-sm tracking-wider">★★★★★</div>
            <span class="text-[10px] text-emerald-400 bg-emerald-950/80 px-2.5 py-0.5 rounded-full border border-emerald-500/30 font-bold">✨ Verified Purchase</span>
          </div>
          <h4 class="font-serif text-lg font-bold text-white mb-2 leading-snug">"Super convenient in shower"</h4>
          <p class="text-xs sm:text-sm text-gray-300 leading-relaxed mb-4 font-light">
            Very easy. Just apply during shower, leave 3 minutes, rinse. Cash on delivery reached Kanpur in 48 hours. Already ordered 2 more bottles for my family!
          </p>
        </div>
        <div class="pt-4 border-t border-white/10 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-gradient-to-r from-[#d4af37] to-[#aa7c11] text-black font-black text-xs flex items-center justify-center">AM</div>
            <div>
              <span class="text-xs sm:text-sm font-bold text-white block">Alok Mishra</span>
              <span class="text-[10px] text-gray-400">Kanpur &bull; 46 yrs</span>
            </div>
          </div>
          <span class="text-[11px] text-amber-400 font-mono">2 Bottles Pack</span>
        </div>
      </div>

    </div>

    <!-- CTA to Full Reviews Deck -->
    <div class="text-center">
      <a href="/pages/reviews" class="inline-flex items-center gap-2 px-8 py-4 rounded-2xl bg-gradient-to-r from-[#d4af37] via-[#f7e7a7] to-[#aa7c11] text-black text-xs sm:text-sm font-black uppercase tracking-wider shadow-xl hover:scale-105 transition-all cursor-pointer">
        <span>Read All 1,280+ Verified Customer Reviews</span>
        <span>&rarr;</span>
      </a>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Reviews Section",
  "settings": []
}
{% endschema %}
