{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/admin",
      "dest": "/admin/index.html",
      "headers": {
        "cache-control": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
